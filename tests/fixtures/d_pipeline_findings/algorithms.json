  "algorithms": [
    {
      "id": "algo-icp",
      "name": "ICP",
      "node": "algo:icp",
      "purpose": "Estimate the rigid transform aligning the source cloud to the target cloud.",
      "inputs": ["source cloud", "target cloud", "max_iters", "tol"],
      "outputs": ["4x4 transform", "rmse"],
      "stages": [
        {"id": "init", "name": "Initialise transform", "kind": "step",
         "evidence": [{"file": "registration/icp.py", "lines": "34-37", "symbol": "prev_error", "status": "confirmed"}]},
        {"id": "iterate", "name": "Iterate up to max_iters", "kind": "loop",
         "evidence": [{"file": "registration/icp.py", "lines": "38", "symbol": "max_iters", "status": "confirmed"}]},
        {"id": "match", "name": "Find correspondences (nearest neighbour)", "kind": "step",
         "functions": ["fn:registration/icp.py:find_correspondences"],
         "evidence": [{"file": "registration/icp.py", "lines": "39", "symbol": "find_correspondences", "status": "confirmed"}]},
        {"id": "fit", "name": "Estimate transform (SVD)", "kind": "step",
         "functions": ["fn:registration/icp.py:estimate_transform"],
         "evidence": [{"file": "registration/icp.py", "lines": "41", "symbol": "estimate_transform", "status": "confirmed"}]},
        {"id": "apply", "name": "Apply transform", "kind": "step",
         "functions": ["fn:registration/icp.py:apply_transform"],
         "evidence": [{"file": "registration/icp.py", "lines": "42-43", "symbol": "apply_transform", "status": "confirmed"}]},
        {"id": "check", "name": "RMSE change < tol?", "kind": "decision",
         "evidence": [{"file": "registration/icp.py", "lines": "44-45", "symbol": "tol", "status": "confirmed"}]},
        {"id": "done", "name": "Return transform and RMSE", "kind": "terminal",
         "evidence": [{"file": "registration/icp.py", "lines": "48", "symbol": "return", "status": "confirmed"}]}
      ],
      "transitions": [
        {"from": "init", "to": "iterate", "label": "start"},
        {"from": "iterate", "to": "match", "label": "next iteration"},
        {"from": "match", "to": "fit", "label": "pairs"},
        {"from": "fit", "to": "apply", "label": "transform"},
        {"from": "apply", "to": "check", "label": "rmse"},
        {"from": "check", "to": "done", "label": "converged"},
        {"from": "check", "to": "iterate", "label": "not converged"},
        {"from": "iterate", "to": "done", "label": "max_iters reached"}
      ],
      "evidence": [
        {"file": "registration/icp.py", "lines": "32-48", "symbol": "register", "status": "confirmed"}
      ]
    }
  ],
  "uncertainties": [
    "Brute-force nearest neighbour is O(N*M); large clouds may need a KD-tree (not present in code)."
  ]
