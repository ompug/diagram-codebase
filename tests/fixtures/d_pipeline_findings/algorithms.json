  "dataflows": [
    {
      "id": "df-registration",
      "name": "Point-cloud registration data flow",
      "stages": [
        {"node": "data:raw-cloud", "role": "input", "representation": "ndarray N x 3"},
        {"node": "data:downsampled-cloud", "role": "transform", "representation": "ndarray M x 3"},
        {"node": "data:correspondences", "role": "intermediate", "representation": "index array"},
        {"node": "data:transform", "role": "intermediate", "representation": "4x4 matrix"},
        {"node": "data:result", "role": "output", "representation": "text file"}
      ],
      "links": [
        {"from": "data:raw-cloud", "to": "data:downsampled-cloud", "label": "voxel + outliers"},
        {"from": "data:downsampled-cloud", "to": "data:correspondences", "label": "nearest neighbour"},
        {"from": "data:correspondences", "to": "data:transform", "label": "SVD"},
        {"from": "data:transform", "to": "data:result", "label": "save_result"}
